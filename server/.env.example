# Copy to server/.env and fill in. Never commit server/.env.
GEMINI_API_KEY=
# Where the site is published, comma-separated. Leave empty while testing on this computer.
ALLOWED_ORIGINS=
# Switch the coach's question box or voice off (for example while you check the children's privacy rules).
# ASK=off
# VOICE=off
# JUDGE=off   # skips the second safety check of each answer; not recommended
# TRUST_PROXY=1   # set when the host puts a proxy in front, so limits count real visitors
# Optional overrides
# CHAT_MODEL=gemini-flash-latest
# JUDGE_MODEL=gemini-flash-lite-latest
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE=Achird
# ASK_PER_HOUR=20
# SPEAK_PER_HOUR=150
# ASK_PER_DAY_TOTAL=2000
# SPEAK_PER_DAY_TOTAL=8000
